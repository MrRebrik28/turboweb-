# ==============================================================
# Конфигурация Автономного Агента LocalWeb для ВКонтакте
# ==============================================================

# Токен пользователя ВКонтакте (Standalone приложение)
# Необходимые права доступа (scope): wall,groups,photos,offline
# Подробная инструкция по получению токена описана в README.md
VK_USER_TOKEN=vk1.a.your_token_here_example

# ID существующего сообщества (число без минуса).
# Если оставить пустым, агент автоматически СОЗДАСТ НОВЫЙ ПАБЛИК,
# настроит его описание, установит аватар и обложку.
VK_GROUP_ID=

# Путь к исполняемому файлу Google Chrome (для генерации графики)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
